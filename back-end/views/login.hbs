<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/login.css">
    <title>Document</title>
</head>
<body>
    <form class="table btnCenter" action="/login" method="post" name="loginForm">
        <div class="upperbox">
            <img src="/images/FullKevlerLogo.png" alt="">
        </div>    
        <div class="lowerbox">
            <label for="username" class="text-1">username: </label>
            <input class="input-box" type="text" id="username" name="username">
            <label for="password" class="text-1">password: </label>
            <input class="input-box" type="password" id="password" name="password">
            <b><p type = 'error' id = 'loginError'>{{error}}</p></b>
            <button type="submit" id="login" class="btn-login">Login</button>
        </div>
    </form>
    <form class="recovery" action="/passwordRecovery" method="get" name="Recovery">
        <button type="submit" id="forgotPassword" class="btn-login">Forgot Password</button>
    </form>
     <form class="register" action="/registerUser" method="get" name="Registration">
        <button type="submit" id="registerNew" class="btn-login">New User?</button>
    </form>
</body>