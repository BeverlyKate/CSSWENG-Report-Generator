<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/login.css">
    <title>Register</title>
</head>
<body>
    <form class="table btnCenter" action="/newUser" method="post" name="registerForm">
        <div class="upperbox">
            <img src="/images/FullKevlerLogo.png" alt="">
        </div>    
        <div class="lowerbox">
            <label for="email" class="text-1">Email: </label>
            <input class="input-box" type="email" id="email" name="email" required>
            <label for="username" class="text-1">Username: </label>
            <input class="input-box" type="text" id="username" name="username" required>
            <label for="password" class="text-1">Password: </label>
            <input class="input-box" type="password" id="password" name="password" required>
            <label for="retypePassword" class="text-1">Retype Password: </label>
            <input class="input-box" type="password" id="retypePassword" name="retypePassword" required>
            <label for="role" class="text-1">Role: </label>
            <select class="input-box" id="role" name="role" required>
                <option value="admin">Admin</option>
                <option value="guest">Guest</option>
            </select>
            <b><p id="registerError">{{error}}</p></b>
            <button type="submit" id="register" class="btn-login">Register</button>
        </div>
    </form>
</body>
</html>
